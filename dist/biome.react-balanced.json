{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "preset": "recommended",
      "source": {
        "noDuplicateClasses": "on"
      }
    }
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "useEditorconfig": true
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "experimentalEmbeddedSnippetsEnabled": true,
    "globals": [],
    "jsxRuntime": "transparent",
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "operatorLinebreak": "before",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    },
    "parser": {
      "jsxEverywhere": true,
      "unsafeParameterDecoratorsEnabled": false
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noAmbiguousAnchorText": "warn",
        "noNoninteractiveElementInteractions": "warn",
        "noNoninteractiveElementToInteractiveRole": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "useFocusableInteractive": "info",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noDivRegex": "warn",
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveNestedCallbacks": "warn",
        "noExcessiveNestedTestSuites": "warn",
        "noExcessiveSelectorClasses": "warn",
        "noForEach": "warn",
        "noImplicitCoercions": "off",
        "noPlaywrightUselessAwait": "warn",
        "noRedundantDefaultExport": "warn",
        "noUnnecessaryTemplateExpression": "warn",
        "noUselessCatchBinding": "warn",
        "noUselessReturn": "info",
        "noUselessStringConcat": "warn",
        "noUselessUndefined": "warn",
        "noVoid": "warn",
        "useArrayFind": "warn",
        "useArraySome": "warn",
        "useMaxParams": "warn",
        "useRegexpTest": "warn",
        "useSimplifiedLogicExpression": "warn",
        "useWhile": "warn",
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 100
          }
        }
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noChildrenProp": "warn",
        "noComponentHookFactories": "warn",
        "noDuplicateAttributes": "warn",
        "noGlobalDirnameFilename": "warn",
        "noJsxNamespace": "warn",
        "noNestedComponentDefinitions": "warn",
        "noNextAsyncClientComponent": "warn",
        "noNodejsModules": "warn",
        "noPlaywrightMissingAwait": "warn",
        "noPrivateImports": "warn",
        "noProcessGlobal": "warn",
        "noReactNativeRawText": "warn",
        "noReactPropAssignments": "warn",
        "noRenderReturnValue": "warn",
        "noRestrictedElements": "warn",
        "noUndeclaredDependencies": "warn",
        "noUndeclaredVariables": "warn",
        "noUnresolvedImports": "off",
        "noUnusedInstantiation": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "warn",
        "useImportExtensions": "off",
        "useInlineScriptId": "warn",
        "useJsonImportAttributes": "warn",
        "useJsxKeyInIterable": "warn",
        "usePlaywrightValidDescribeCallback": "warn",
        "useReactAsyncServerFunction": "warn",
        "useReactNativePlatformComponents": "warn",
        "useSingleJsDocAsterisk": "warn",
        "useUniqueElementIds": "warn"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "warn",
        "noArgumentsCallerOrCallee": "warn",
        "noBaseToString": "warn",
        "noBunModules": "warn",
        "noDoubleComparison": "warn",
        "noExcessiveStatementsPerFunction": "off",
        "noExtendNative": "warn",
        "noFloatingPromises": "warn",
        "noImpliedEval": "warn",
        "noInvalidFileInputAccept": "warn",
        "noInvalidPropertyInitValue": "warn",
        "noInvalidThis": "warn",
        "noJsonUnsafeValues": "warn",
        "noJsRestrictedProperties": "warn",
        "noMeaninglessVoidOperator": "warn",
        "noMisleadingReturnType": "warn",
        "noMisplacedListElements": "warn",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "warn",
        "noNestedSwitch": "warn",
        "noNestedTemplateLiterals": "warn",
        "noNonScalableViewport": "warn",
        "noObjectConstructor": "warn",
        "noObsoleteTags": "warn",
        "noOctal": "warn",
        "noProcessExit": "warn",
        "noPromiseExecutorReturn": "warn",
        "noReactObjectTypeAsDefaultProp": "warn",
        "noRestrictedDependencies": "warn",
        "noReturnInFinally": "warn",
        "noSelfImport": "warn",
        "noTailwindArbitraryValue": "off",
        "noTailwindLegacyUtilities": "off",
        "noTailwindRawColors": "off",
        "noTailwindRestyledComponents": "off",
        "noThisOutsideOfClass": "warn",
        "noUndeclaredClasses": "warn",
        "noUndeclaredCustomProperties": "info",
        "noUnmodifiedLoopCondition": "warn",
        "noUnsafeIframeSandbox": "warn",
        "noUnsafePlusOperands": "warn",
        "noUnsafeTypeAssertion": "off",
        "noUnsafeUnaryMinus": "warn",
        "noUnusedClasses": "warn",
        "noUselessAssignment": "warn",
        "noUselessCall": "warn",
        "noUselessDateGetTime": "warn",
        "noUselessTypeConversion": "warn",
        "noXorAsExponentiation": "warn",
        "noZeroFractions": "warn",
        "useAwaitThenable": "warn",
        "useBetterDomTraversing": "info",
        "useBigintLiterals": "warn",
        "useCapitalizedConstructors": "warn",
        "useConsistentFunctionStyle": "off",
        "useConsistentJsonFileRead": "warn",
        "useConsistentObjectKeys": "warn",
        "useControlLabel": "warn",
        "useDisposables": "warn",
        "useExhaustiveSwitchCases": "warn",
        "useExplicitReturnType": "warn",
        "useExplicitType": "off",
        "useFlatMathMinMax": "warn",
        "useIncludes": "warn",
        "useLayeredStyles": "off",
        "useLogicalProperties": "off",
        "useLowercaseTestTitle": "off",
        "useMatchingFunctionName": "warn",
        "useModernMathApis": "warn",
        "useNamedFunction": "warn",
        "useNamedLayer": "warn",
        "useNullishCoalescing": "warn",
        "usePromiseRejectErrors": "warn",
        "useReactCompiler": "off",
        "useReactFunctionComponentDefinition": "warn",
        "useReactNamingConvention": "info",
        "useRegexpExec": "warn",
        "useSimplifiedBooleanReturn": "warn",
        "useStrictBooleanExpressions": "off",
        "useStringStartsEndsWith": "warn",
        "useTailwindShorthandClasses": "warn",
        "useTailwindSortedClasses": "warn",
        "useTailwindStaticClassStrings": "off",
        "useUnaryMinus": "warn",
        "useValidTestTitle": "info"
      },
      "performance": {
        "noAwaitInLoops": "warn",
        "noBarrelFile": "off",
        "noDelete": "warn",
        "noImgElement": "off",
        "noJsxPropsBind": "error",
        "noNamespaceImport": "off",
        "noReExportAll": "off",
        "noSyncScripts": "warn",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn",
        "useTopLevelRegex": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noDangerouslySetInnerHtmlWithChildren": "warn",
        "noScriptUrl": "warn",
        "noSecrets": "warn",
        "useIframeSandbox": "warn"
      },
      "style": {
        "noCommonJs": "warn",
        "noContinue": "info",
        "noDefaultExport": "off",
        "noDoneCallback": "warn",
        "noEnum": "warn",
        "noExcessiveClassesPerFile": "warn",
        "noExcessiveLinesPerFile": "warn",
        "noExportedImports": "warn",
        "noHeadElement": "warn",
        "noHexColors": "warn",
        "noImplicitBoolean": "info",
        "noInferrableTypes": "warn",
        "noInlineStyles": "warn",
        "noJsxLiterals": "off",
        "noMagicNumbers": "info",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "warn",
        "noNegationElse": "warn",
        "noNestedTernary": "off",
        "noParameterAssign": "warn",
        "noParameterProperties": "warn",
        "noPlaywrightElementHandle": "warn",
        "noPlaywrightEval": "warn",
        "noPlaywrightWaitForSelector": "warn",
        "noProcessEnv": "warn",
        "noReactNativeLiteralColors": "warn",
        "noRestrictedGlobals": "warn",
        "noRestrictedImports": "warn",
        "noRestrictedTypes": "warn",
        "noShoutyConstants": "warn",
        "noSubstr": "warn",
        "noTernary": "off",
        "noTopLevelLiterals": "warn",
        "noUnusedTemplateLiteral": "warn",
        "noUselessElse": "warn",
        "noValueAtRule": "warn",
        "noYodaExpression": "warn",
        "useAsConstAssertion": "warn",
        "useAtIndex": "warn",
        "useBlockStatements": "warn",
        "useCollapsedElseIf": "warn",
        "useCollapsedIf": "warn",
        "useComponentExportOnlyModules": "warn",
        "useConsistentArrowReturn": "warn",
        "useConsistentBuiltinInstantiation": "warn",
        "useConsistentCurlyBraces": "warn",
        "useConsistentEnumValueType": "warn",
        "useConsistentMemberAccessibility": "warn",
        "useConsistentMethodSignatures": "warn",
        "useConsistentObjectDefinitions": "warn",
        "useConsistentTestIt": "warn",
        "useDefaultParameterLast": "warn",
        "useDefaultSwitchClause": "warn",
        "useDestructuring": "warn",
        "useDomQuerySelector": "warn",
        "useEnumInitializers": "warn",
        "useErrorCause": "warn",
        "useExplicitLengthCheck": "warn",
        "useExportsLast": "warn",
        "useFilenamingConvention": "warn",
        "useForOf": "warn",
        "useFragmentSyntax": "warn",
        "useGlobalThis": "warn",
        "useGroupedAccessorPairs": "warn",
        "useImportsFirst": "warn",
        "useNamedCaptureGroup": "warn",
        "useNodeAssertStrict": "warn",
        "useNumberNamespace": "warn",
        "useNumericSeparators": "warn",
        "useObjectSpread": "warn",
        "useReactFunctionComponents": "warn",
        "useReadonlyClassProperties": "warn",
        "useReduceTypeParameter": "warn",
        "useSelfClosingElements": "warn",
        "useShorthandAssign": "warn",
        "useSingleVarDeclarator": "warn",
        "useSpreadOverApply": "warn",
        "useSymbolDescription": "warn",
        "useTestHooksInOrder": "warn",
        "useTestHooksOnTop": "warn",
        "useThisInClassMethods": "warn",
        "useThrowNewError": "warn",
        "useThrowOnlyError": "warn",
        "useTrimStartEnd": "warn",
        "useUnicodeRegex": "warn",
        "useUnifiedTypeSignatures": "warn",
        "useVarsOnTop": "warn",
        "noIncrementDecrement": {
          "level": "warn",
          "options": {
            "allowForLoopAfterthoughts": true
          }
        },
        "useConsistentArrayType": {
          "level": "warn",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": {
            "style": "type"
          }
        },
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "requireAscii": true,
            "strictCase": false
          }
        }
      },
      "suspicious": {
        "noAlert": "warn",
        "noArrayIndexKey": "warn",
        "noBitwiseOperators": "warn",
        "noConditionalExpect": "warn",
        "noConsole": "warn",
        "noConstantBinaryExpressions": "warn",
        "noDeprecatedImports": "warn",
        "noDocumentImportInPage": "warn",
        "noDrizzleDeleteWithoutWhere": "warn",
        "noDrizzleUpdateWithoutWhere": "warn",
        "noDuplicateDependencies": "warn",
        "noDuplicatedSpreadProps": "warn",
        "noDuplicateSelectors": "warn",
        "noDuplicateTestHooks": "warn",
        "noEmptyBlockStatements": "warn",
        "noEmptyObjectKeys": "warn",
        "noEmptySource": "warn",
        "noEqualsToNull": "warn",
        "noEvolvingTypes": "warn",
        "noExportsInTest": "warn",
        "noFocusedTests": "warn",
        "noForIn": "warn",
        "noHeadImportInDocument": "warn",
        "noIdenticalTestTitle": "warn",
        "noImportCycles": "warn",
        "noJsxLeakedDollar": "warn",
        "noLeakedRender": "error",
        "noLoopFunc": "warn",
        "noMisplacedAssertion": "warn",
        "noNestedPromises": "warn",
        "noParametersOnlyUsedInRecursion": "error",
        "noPlaywrightForceOption": "warn",
        "noPlaywrightNetworkidle": "warn",
        "noPlaywrightPagePause": "warn",
        "noPlaywrightWaitForNavigation": "warn",
        "noPlaywrightWaitForTimeout": "warn",
        "noReactForwardRef": "warn",
        "noReactNativeDeepImports": "warn",
        "noReactStringRefs": "warn",
        "noReturnAssign": "warn",
        "noShadow": "warn",
        "noSkippedTests": "warn",
        "noUnassignedVariables": "warn",
        "noUndeclaredEnvVars": "warn",
        "noUnknownAttribute": "warn",
        "noUnnecessaryConditions": "warn",
        "noUntrustedLicenses": "warn",
        "noUnusedExpressions": "warn",
        "noVar": "error",
        "useArraySortCompare": "warn",
        "useAwait": "warn",
        "useBaseline": "warn",
        "useErrorMessage": "warn",
        "useExpect": "warn",
        "useGuardForIn": "warn",
        "useNumberToFixedDigitsArgument": "warn",
        "useRequiredScripts": "warn",
        "useStaticResponseMethods": "warn",
        "useStrictMode": "warn"
      }
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
